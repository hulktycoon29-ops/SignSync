# Copy to .env for local use. Never commit real secrets.
# Secret used to sign session tokens. Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# Local server port
PORT=3000

# Admin console (#/admin). Required to enable it; there is no default password.
# Use a strong password and do not reuse one from elsewhere.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
